{
	"name": "@justonemonkey/n8n-nodes-twitch",
	"version": "1.0.4",
	"description": "n8n community node for the Twitch API and EventSub, with shared WebSocket support for multiple triggers",
	"license": "MIT",
	"homepage": "https://github.com/JustOMonkey/n8n-nodes-twitch",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "JUSTONEMONKEY",
		"email": "contact@justonemonkey.space"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/JustOMonkey/n8n-nodes-twitch"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/TwitchUserOAuth2Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/Twitch/Twitch.node.js",
			"dist/nodes/TwitchTrigger/TwitchTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.49.1",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "^21.0.3",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
